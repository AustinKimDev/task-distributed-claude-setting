{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/wiki-session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/wiki-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/rtk-rewrite.sh"
          },
          {
            "type": "command",
            "command": "node <HOME>/.claude/hooks/block-dangerous-commands.js"
          },
          {
            "type": "command",
            "command": "node <HOME>/.claude/hooks/protect-secrets.js"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node <HOME>/.claude/hooks/protect-secrets.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "<HOME>/.claude/hooks/main-branch-protection.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash <HOME>/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "fullstack-dev-skills@fullstack-dev-skills": true,
    "marketing-skills@marketingskills": true,
    "firebase@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true
}
